# Bloom (Telegram digest) — секреты. Скопируй в bloom/.env на проде. Не коммить.

# Токен бота (@bloom26bot)
TELEGRAM_BOT_TOKEN=

# Групповой чат марафона
MARATHON_CHAT_ID=-1002782157458

# Прокси для api.telegram.org (на РФ VPS Telegram без VPN не открывается).
# Взять у провайдера VPN или свой SOCKS/HTTP. Примеры:
# TELEGRAM_PROXY_URL=socks5://user:pass@proxy.example.com:1080
# TELEGRAM_PROXY_URL=http://user:pass@proxy.example.com:8080
# TELEGRAM_PROXY_URL=

# Опционально: тестовый чат для smoke (личка Макса)
# MARATHON_CHAT_ID=310055372

# Passive ingest: только этот chat_id пишется в telegram_chat_events
# (тот же MARATHON_CHAT_ID)
